# Địa chỉ API gateway. Local: http://localhost:8088
# Vercel: đặt VITE_API_BASE_URL trong Project Settings → Environment Variables
# (vd https://api-staging.<domain>), rồi thêm domain Vercel vào CORS_ALLOWED_ORIGINS của backend.
VITE_API_BASE_URL=http://localhost:8088

# Cờ tính năng: "true" là bật, bỏ trống/khác là tắt. Trên Vercel đổi cờ xong phải Redeploy.
# Ô "Tìm bằng AI" ở trang chủ (Gemini)
VITE_FEATURE_AI_SEARCH=false
# Trang admin Hoàn tiền (danh sách khoản DEAD + nút Thử lại)
VITE_FEATURE_ADMIN_REFUNDS=false
